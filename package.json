{
  "name": "fbpage-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "db:generate": "pnpm --filter db-prisma run generate",
    "db:migrate": "pnpm --filter db-prisma run migrate",
    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
