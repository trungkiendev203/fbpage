# Environment Configuration Template
NODE_ENV=development
PORT=4000
META_GRAPH_API_VERSION=v20.0

# Database Connection
DATABASE_URL="postgresql://fbpage_admin:fbpage_secure_password_123@localhost:5432/fbpage_prod?schema=public"

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# MinIO S3 Storage Connection
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secure_password_123
MINIO_BUCKET_NAME=fbpage-media

# Security & Master Encryption Key (AES-256-GCM - Must be exactly 32 bytes / 64 hex chars)
MASTER_ENCRYPTION_KEY=6162636465666768696a6b6c6d6e6f707172737475767778797a303132333435
JWT_SECRET=super_secret_jwt_key_change_me_in_production_123!
META_APP_SECRET=your_meta_app_secret_here
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
